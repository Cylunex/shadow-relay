{
  "type": "object",
  "properties": {
    "schema": {
      "const": "shadow.podcast/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "pattern": "^audio/"
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "title",
          "url",
          "type",
          "length"
        ]
      }
    }
  },
  "required": [
    "schema",
    "title",
    "episodes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadow Relay podcast manifest"
}
