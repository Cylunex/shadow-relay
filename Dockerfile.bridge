FROM golang:1.26.4-alpine AS build
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/relay-bridge/ ./cmd/relay-bridge/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /relay-bridge ./cmd/relay-bridge

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /relay-bridge /app/relay-bridge
USER 65532:65532
ENTRYPOINT ["/app/relay-bridge"]
CMD ["--output", "/plugins/thirdparty", "--interval", "15m"]
