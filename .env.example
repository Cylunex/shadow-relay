RELAY_DATABASE_URL=postgres://relay:REPLACE_DATABASE_PASSWORD@database/relay?sslmode=disable
RELAY_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
RELAY_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
RELAY_DATA_DIR=/var/lib/relay
RELAY_LISTEN=:8080
RELAY_WEB_DIR=/app/web
# Trusted service networks must be explicitly configured; empty denies all private targets.
RELAY_TRUSTED_CIDRS=
RELAY_WORKERS=2
RELAY_PUBLIC_URL=https://relay.example.com
RELAY_DB_PASSWORD=REPLACE_DATABASE_PASSWORD
# Optional local development binding; put actual mappings in ignored local config.
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_PORT=8080

# Optional named HTTP(S) CONNECT proxies. Keep real URLs/passwords in ignored local config.
# Sources select a profile with proxyId; omitted/empty means direct.
RELAY_PROXIES={}
